# Copy this file to .env and adjust paths for your machine.

# Host directory containing rosbags, mounted read-only into the container.
ROSBAGS_DIR=/mnt/data_8tb/rosbags

# Host directory for map/graph output, mounted read-write into the container.
DATA_OUT_DIR=./data_out

# ROS topic (sensor_msgs/PointCloud2) to feed hdl_graph_slam as the lidar input.
LIDAR_POINTS_TOPIC=/go2w_008/merged_cloud

# Bag subdirectory to play, relative to ROSBAGS_DIR.
BAG_SUBDIR=go2w_mexico/robot_data/full_three_floor_loop

# TF frame of the robot base (hdl_graph_slam base_link_frame_id).
BASE_LINK_FRAME=go2w_008/base
